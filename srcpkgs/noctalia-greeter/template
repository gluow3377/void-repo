post_install() {
	rm -r ${DESTDIR}/usr/lib/tmpfiles.d
	rmdir ${DESTDIR}/usr/lib

	vsconf examples/greeter.toml
	vdoc ${FILESDIR}/README.voidlinux

	vlicense LICENSE
	vlicense ${FILESDIR}/LICENSE.wuffs
	vlicense assets/fonts/tabler-icons-license.txt LICENSE.tabler-icons
}
