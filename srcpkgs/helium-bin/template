# Template file for 'helium-bin'
pkgname=helium-bin
version=0.21.1.1
revision=1
archs="x86_64"
depends="gtk+3 hicolor-icon-theme liberation-fonts-ttf xdg-utils"
short_desc="Private, fast, and honest Chromium-based web browser"
maintainer="gluow3377 <344402541+gluow3377@users.noreply.github.com>"
license="GPL-3.0-only"
homepage="https://helium.computer"
changelog="https://github.com/imputnet/helium-linux/releases"
distfiles="https://github.com/imputnet/helium-linux/releases/download/${version}/helium-${version}-x86_64_linux.tar.xz"
checksum=6cd7f240153cb9c0cdfa27bf1a6651ddcae73a898afc449a93dd10da83b4bd45
nostrip=yes
noshlibprovides=yes
skiprdeps="/usr/lib/helium/libqt5_shim.so /usr/lib/helium/libqt6_shim.so"

post_patch() {
	vsed -i helium-wrapper -e 's/\(CHROME_VERSION_EXTRA=\).*/\1xbps/'
}

do_install() {
	vmkdir usr/lib/helium
	vcopy "*" usr/lib/helium
	vmkdir usr/bin
	ln -s /usr/lib/helium/helium-wrapper ${DESTDIR}/usr/bin/helium
	vinstall helium.desktop 644 usr/share/applications
	vinstall product_logo_256.png 644 usr/share/icons/hicolor/256x256/apps helium.png
}
